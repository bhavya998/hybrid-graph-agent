# ============================================================
# hga — environment configuration. Copy to .env and fill in.
# Default: local_gpu (self-hosted) — no API keys needed.
# Switch to local for all-API (Anthropic + Voyage + Cohere).
# ============================================================

# --- provider profile ---
# local_gpu = self-hosted GPU (bge-small + bge-reranker-base + Qwen 1.5B 4-bit)
# local     = all-API (Anthropic + Voyage + Cohere)
# databricks = Databricks/Mosaic AI parity (future)
HGA_PROFILE=local_gpu

# ============================================================
# local_gpu profile — no API keys required
# Models are auto-downloaded from HuggingFace on first use.
# ============================================================
HGA_LOCAL_EMBED_MODEL=BAAI/bge-small-en-v1.5
HGA_LOCAL_RERANK_MODEL=BAAI/bge-reranker-base
HGA_LOCAL_LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
HGA_LOCAL_LLM_4BIT=true

# ============================================================
# local profile (all-API) — only needed if profile=local
# ============================================================
# ANTHROPIC_API_KEY=sk-ant-...
# HGA_PLANNER_MODEL=claude-sonnet-4-5-20250929
# HGA_EXTRACTOR_MODEL=claude-haiku-4-5-20251001
# VOYAGE_API_KEY=pa-...
# HGA_TEXT_EMBED_MODEL=voyage-3-large
# HGA_MULTIMODAL_EMBED_MODEL=voyage-multimodal-3
# COHERE_API_KEY=...
# HGA_RERANK_MODEL=rerank-v3.5

# --- LlamaParse (fallback PDF parser) ---
# LLAMA_CLOUD_API_KEY=...

# --- Langfuse Cloud (observability) ---
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# --- Runtime config ---
HGA_DATA_DIR=./data
HGA_QDRANT_PATH=./data/qdrant
HGA_KUZU_PATH=./data/kuzu
HGA_GRAPHRAG_OUTPUT=./data/graphrag_output
HGA_CHUNKS_PATH=./data/processed/chunks.parquet
HGA_LOG_LEVEL=INFO
